# ===================================================================================
# Scalable E-Commerce - Environment Variables Template
# ===================================================================================
# Instructions:
#   1. Copy this file: cp .env.example .env
#   2. Fill in real values in your .env file
#   3. NEVER commit the .env file to version control
# ===================================================================================

# --- Database ---
# Shared PostgreSQL password used by all services (user-service, order-service, stock-service)
DB_PASSWORD=your_secure_db_password_here

# --- JWT ---
# A cryptographically strong random secret for signing JWT tokens.
# Must be the SAME value across user-service and order-service.
# Generate with: openssl rand -hex 64
JWT_SECRET=your_64_character_hex_secret_here

# --- AWS / LocalStack S3 ---
# For local development with LocalStack, leave these as "test".
# Replace with real AWS IAM credentials for production deployments.
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
